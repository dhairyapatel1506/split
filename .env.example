# Copy to .env (git-ignored) and fill in. All values optional in dev —
# missing ones fall back to safe local defaults.

# Brevo transactional email (https://app.brevo.com → SMTP & API → API keys)
BREVO_API_KEY=
# Sender address — must be a verified sender/domain in Brevo
EMAIL_FROM=split@dhairya.cloud
# Base URL used in email links
APP_BASE_URL=http://localhost:5173

# Session cookie signing secret — set a long random value in production
# COOKIE_SECRET=

# DATABASE_URL=postgres://split:split@localhost:5432/split
# REDIS_URL=redis://localhost:6379
